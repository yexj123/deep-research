# Copy to .env and fill in. .env is gitignored; .env.example is not (D-002).
#
# IMPORTANT: nothing loads .env automatically. The app reads os.environ, so a .env sitting
# in the repo root has no effect on its own. Either:
#
#   uv run uvicorn deep_research.api.main:create_app --factory --reload --env-file .env
#
# (uvicorn[standard] ships python-dotenv, so --env-file works out of the box), or export the
# variables yourself:
#
#   PowerShell   $env:OPENAI_API_KEY = "sk-..."
#   bash / zsh   export OPENAI_API_KEY="sk-..."
#
# pytest does NOT read .env either, so the paid markers (-m integration / record / eval) need
# the variables exported in that shell.


# --- the only two variables the app itself reads -----------------------------------------
# agent/config.py maps provider -> variable; agent/llm.py raises if the one you picked is
# unset. You need whichever providers you actually use, not both.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=


# --- evaluation harness (tests/eval), all optional ---------------------------------------
# Only read when recording arms. Defaults come from agent/config.py, and every one of these
# lands in the recording's arm name, so a run can never be filed under settings that did not
# produce it. Uncomment when you need an arm other than the default.
#
# EVAL_QUESTION_SET=broad       # broad | narrow | staleness
# EVAL_MAX_DEPTH=2              # overrides MAX_DEPTH for this recording
# EVAL_LOCAL_FIRST=1            # 0 records the arXiv-only arm
# EVAL_FULL_TEXT=0              # 1 uses the enriched full-text corpus (D-109)
# EVAL_STALE_CORPUS=0           # 1 reads the dated O-16 snapshot -- see docs/staleness-experiment.md
