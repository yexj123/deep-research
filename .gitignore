.vscode/
.idea/
Thumbs.db
.DS_Store

# Evaluation recordings ARE committed on purpose (O-11): they are the baseline that a later
# full-text run gets compared against, and a baseline nobody can see is not evidence.
# !tests/eval/recordings/

# Playwright MCP scratch output (snapshots, console logs) from /demo-check
.playwright-mcp/

# The full-text corpus is regenerable (uv run python -m tests.eval.enrich) and large.
# Abstracts rebuild from the committed recordings; full text is fetched, never redistributed (D-008).
tests/eval/corpus-fulltext.sqlite
